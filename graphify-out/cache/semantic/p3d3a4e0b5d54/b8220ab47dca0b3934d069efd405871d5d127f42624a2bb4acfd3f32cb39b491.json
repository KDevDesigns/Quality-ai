{"nodes": [{"id": "docs_plan_qa_ai_build_plan", "label": "QA AI for In-House ERP Build Plan", "file_type": "document", "source_file": "docs/PLAN.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Roadmap for QA Hub. Sections 1-7 and Phases 4-11 are the original workbench design, kept as background for Phase 3.6; CLAUDE.md wins where they conflict."}, {"id": "docs_plan_meter_to_cash", "label": "Meter-to-Cash Process", "file_type": "concept", "source_file": "docs/PLAN.md", "source_location": "L18", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_procure_to_pay", "label": "Procure-to-Pay Process", "file_type": "concept", "source_file": "docs/PLAN.md", "source_location": "L19", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_record_to_report", "label": "Record-to-Report Process", "file_type": "concept", "source_file": "docs/PLAN.md", "source_location": "L20", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_hire_to_retire", "label": "Hire-to-Retire / Time-to-Pay Process", "file_type": "concept", "source_file": "docs/PLAN.md", "source_location": "L21", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_deterministic_oracles", "label": "Deterministic Oracles", "file_type": "rationale", "source_file": "docs/PLAN.md", "source_location": "L199", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Money, quantities and balances are checked by code, never AI opinion. LLM oracles are not a source of truth; accounting or billing sign-off on hand-worked examples is the trust anchor."}, {"id": "docs_plan_hybrid_privacy_routing", "label": "Hybrid Privacy Routing", "file_type": "rationale", "source_file": "docs/PLAN.md", "source_location": "L53", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Original workbench rule: sensitive data goes local only or is redacted before a cloud call, and sensitive tasks fail rather than fall back to the cloud. The lib/ai code has since been removed."}, {"id": "docs_plan_risk_based_testing", "label": "Risk-Based Testing (ISO/IEC 25010)", "file_type": "concept", "source_file": "docs/PLAN.md", "source_location": "L39", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Using quality characteristics as a checklist finds more defects than unguided effort, so a likelihood x impact risk register drives test priority."}, {"id": "docs_plan_healer_guardrail", "label": "Healer Guardrail", "file_type": "rationale", "source_file": "docs/PLAN.md", "source_location": "L233", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A healed test can hide a real bug, so the healer may change locators and waits only, never assertions or expected values."}, {"id": "docs_plan_phase_3_5_ticket_hub", "label": "Phase 3.5 QA Ticket Hub", "file_type": "concept", "source_file": "docs/PLAN.md", "source_location": "L274", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "QA and developers stop using Messenger for bugs; replaces the planned Phase 9 Defects screen."}, {"id": "docs_plan_my_dar", "label": "My DAR (Daily Accomplishment Report)", "file_type": "concept", "source_file": "docs/PLAN.md", "source_location": "L290", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_cloud_move", "label": "Cloud Move to Vercel + Supabase", "file_type": "concept", "source_file": "docs/PLAN.md", "source_location": "L300", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_phase_3_7_mobile", "label": "Phase 3.7 QA Hub on Phones", "file_type": "concept", "source_file": "docs/PLAN.md", "source_location": "L306", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Testers should file a bug on the same phone right after it happens, instead of sending the screenshot to a laptop first."}, {"id": "docs_plan_phase_3_7a_mobile_ui", "label": "Phase 3.7a Mobile UI Rework", "file_type": "concept", "source_file": "docs/PLAN.md", "source_location": "L313", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On hold since 2026-11-03 because redesigns were not accepted; the user is designing the UI in the Claude Design canvas first."}, {"id": "docs_plan_phase_3_7b_phone_filing", "label": "Phase 3.7b Filing from the Phone", "file_type": "concept", "source_file": "docs/PLAN.md", "source_location": "L345", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_phase_3_7c_pwa", "label": "Phase 3.7c Install as an App (PWA)", "file_type": "concept", "source_file": "docs/PLAN.md", "source_location": "L362", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_phase_3_8c_web_push", "label": "Phase 3.8c Device Notifications (Web Push)", "file_type": "concept", "source_file": "docs/PLAN.md", "source_location": "L394", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_phase_3_10_ui_polish", "label": "Phase 3.10 UI Polish", "file_type": "concept", "source_file": "docs/PLAN.md", "source_location": "L409", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_phase_3_6a_test_library", "label": "Phase 3.6a Test Library and Manual Runs", "file_type": "concept", "source_file": "docs/PLAN.md", "source_location": "L434", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Comes first because Phase B automates the cases Phase A writes down."}, {"id": "docs_plan_phase_3_6b_record_replay", "label": "Phase 3.6b Record and Replay Regression", "file_type": "concept", "source_file": "docs/PLAN.md", "source_location": "L452", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vercel cannot run browsers, so the runner is a small worker on the QA laptop. Replaces most of Phase 5's generated-spec pipeline for now."}, {"id": "docs_plan_phase_4_data_oracles", "label": "Phase 4 Test Data and Oracles", "file_type": "concept", "source_file": "docs/PLAN.md", "source_location": "L471", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_phase_5_runner", "label": "Phase 5 Automated Runner", "file_type": "concept", "source_file": "docs/PLAN.md", "source_location": "L475", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_phase_6_process_suites", "label": "Phase 6 Business-Process Suites", "file_type": "concept", "source_file": "docs/PLAN.md", "source_location": "L479", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ERP failures happen between modules, so coverage is measured by business journey with assertions at each hand-off, not by screen count."}, {"id": "docs_plan_phase_7_impact_selection", "label": "Phase 7 Change-Impact Selection", "file_type": "concept", "source_file": "docs/PLAN.md", "source_location": "L488", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_phase_8_exploratory_agent", "label": "Phase 8 Exploratory Agent", "file_type": "concept", "source_file": "docs/PLAN.md", "source_location": "L492", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_phase_9_controls_gate", "label": "Phase 9 Controls Suite and Quality Gate", "file_type": "concept", "source_file": "docs/PLAN.md", "source_location": "L496", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "COA findings on ut