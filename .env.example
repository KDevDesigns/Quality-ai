# Copy to .env.local and fill in. Where each value comes from: docs/OPERATIONS.md, section 1.
# Never commit .env.local or paste its values anywhere.

# Supabase → Connect → ORM tab, first line (transaction pooler, port 6543, ?pgbouncer=true)
DATABASE_URL=
# Same tab, second line (session pooler, port 5432); used by prisma migrate only
DIRECT_URL=

# Supabase → Project Settings → Data API
SUPABASE_URL=
# Supabase → Project Settings → API Keys → secret key (sb_secret_…). Server only: never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Random text, 32+ characters. Vercel Cron sends it to /api/cron/daily.
CRON_SECRET=

# Device notifications (Web Push). Make the pair once with: npx web-push generate-vapid-keys
# The public key is public by design. The private key is a secret: server only, never NEXT_PUBLIC_.
# Leave all three empty to turn device notifications off.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# An admin's address, so a push service can reach us about problems: mailto:you@davao-water.gov.ph
VAPID_SUBJECT=

# Optional: video size limit in MB (default 50, the Supabase Free per-file limit)
# NEXT_PUBLIC_VIDEO_MAX_MB=50
# Optional, QA laptop only: where npm run backup writes (default Documents\QA Hub Backups)
# BACKUP_DIR=
