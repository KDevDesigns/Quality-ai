generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// SQLite has no scalar lists: list-shaped fields are Json and validated with zod in lib/schemas.

enum ModuleCode {
  BILLING
  P2P
  FINANCE
  HR
}

enum Priority {
  P1
  P2
  P3
  P4
}

enum TestType {
  UI
  API
  PROCESS
  RECON
  NFR
}

enum TestCaseStatus {
  DRAFT
  APPROVED
  AUTOMATED
  OBSOLETE
}

enum RunTrigger {
  MANUAL
  IMPACT
  SCHEDULED
}

enum RunStatus {
  QUEUED
  RUNNING
  PASSED
  FAILED
  CANCELLED
  ERROR
}

enum ResultStatus {
  PASS
  FAIL
  SKIP
  FLAKY
}

enum ExplorationStatus {
  QUEUED
  RUNNING
  COMPLETED
  STOPPED
  ERROR
}

enum Severity {
  S1
  S2
  S3
  S4
}

enum DefectStatus {
  DRAFT
  CONFIRMED
  FIXED
  VERIFIED
  CLOSED
  REJECTED
}

enum ReviewKind {
  DIFF
  LOG
  BUG
}

model Project {
  id           String        @id @default(cuid())
  name         String        @unique
  description  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  environments Environment[]
}

model Environment {
  id           String        @id @default(cuid())
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  baseUrls     Json // string[]
  apiBaseUrl   String?
  dbConnRef    String? // name of an env var in .env.local, never the connection string itself
  isProduction Boolean       @default(false)
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  testRuns     TestRun[]
  explorations Exploration[]

  @@unique([projectId, name])
}

model Module {
  id           String            @id @default(cuid())
  code         ModuleCode        @unique
  name         String
  description  String?
  processes    BusinessProcess[]
  risks        Risk[]
  defects      Defect[]
  requirements Requirement[]
}

model BusinessProcess {
  id           String        @id @default(cuid())
  moduleId     String
  module       Module        @relation(fields: [moduleId], references: [id])
  name         String        @unique
  description  String?
  steps        Json // ProcessStep[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  risks        Risk[]
  testCases    TestCase[]
  defects      Defect[]
  requirements Requirement[]
}

model Risk {
  id             String           @id @default(cuid())
  moduleId       String
  module         Module           @relation(fields: [moduleId], references: [id])
  processId      String?
  process        BusinessProcess? @relation(fields: [processId], references: [id], onDelete: SetNull)
  title          String
  characteristic String // ISO/IEC 25010:2023, validated in lib/schemas/risk.ts
  likelihood     Int
  impact         Int
  score          Int // likelihood * impact, computed in lib/risk/score.ts
  mitigation     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([score])
}

model Requirement {
  id             String           @id @default(cuid())
  title          String           @default("")
  source         String // "paste" | "upload" | "seed"
  sourceFile     String?
  text           String
  sensitive      Boolean          @default(false)
  moduleId       String?
  module         Module?          @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  processId      String?
  process        BusinessProcess? @relation(fields: [processId], references: [id], onDelete: SetNull)
  openQuestions  Json             @default("[]") // string[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  testCases      TestCase[]
  generationJobs GenerationJob[]
}

enum GenerationStatus {
  QUEUED
  RUNNING
  DONE
  ERROR
}

model GenerationJob {
  id             String           @id @default(cuid())
  requirementId  String
  requirement    Requirement      @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  status         GenerationStatus @default(QUEUED)
  caseCount      Int              @default(0)
  redactionCount Int              @default(0)
  tokensIn       Int              @default(0)
  tokensOut      Int              @default(0)
  costMicroUsd   Int              @default(0)
  error          String?
  createdAt      DateTime         @default(now())
  finishedAt     DateTime?

  @@index([requirementId, createdAt])
}

model TestCase {
  id            String           @id @default(cuid())
  requirementId String?
  requirement   Requirement?     @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  processId     String?
  process       BusinessProcess? @relation(fields: [processId], references: [id], onDelete: SetNull)
  title         String
  technique     String
  preconditions String?
  steps         Json // string[]
  expected      String
  priority      Priority         @default(P3)
  type          TestType
  tags          Json             @default("[]") // string[]
  status        TestCaseStatus   @default(DRAFT)
  aiGenerated   Boolean          @default(false)
  openQuestions Json             @default("[]") // string[]
  processStep   String?
  sortOrder     Int              @default(0)
  approvedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  scripts       TestScript[]
  results       TestResult[]
}

model TestScript {
  id         String    @id @default(cuid())
  testCaseId String
  testCase   TestCase  @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  path       String
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
}

model TestRun {
  id           String        @id @default(cuid())
  envId        String
  env          Environment   @relation(fields: [envId], references: [id])
  trigger      RunTrigger    @default(MANUAL)
  selection    Json
  status       RunStatus     @default(QUEUED)
  startedAt    DateTime?
  finishedAt   DateTime?
  summary      Json?
  createdAt    DateTime      @default(now())
  results      TestResult[]
  reconResults ReconResult[]
}

model TestResult {
  id         String       @id @default(cuid())
  runId      String
  run        TestRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  testCaseId String?
  testCase   TestCase?    @relation(fields: [testCaseId], references: [id], onDelete: SetNull)
  specTitle  String
  status     ResultStatus
  durationMs Int
  error      String?
  artifacts  Json?
}

model ReconCheck {
  id          String        @id @default(cuid())
  name        String        @unique
  sql         String
  expectation String
  results     ReconResult[]
}

model ReconResult {
  id      String     @id @default(cuid())
  runId   String?
  run     TestRun?   @relation(fields: [runId], references: [id], onDelete: Cascade)
  checkId String
  check   ReconCheck @relation(fields: [checkId], references: [id], onDelete: Cascade)
  status  String
  detail  Json?
  at      DateTime   @default(now())
}

model Exploration {
  id         String            @id @default(cuid())
  envId      String
  env        Environment       @relation(fields: [envId], references: [id])
  goal       String
  role       String
  stepBudget Int               @default(40)
  status     ExplorationStatus @default(QUEUED)
  transcript Json              @default("[]")
  createdAt  DateTime          @default(now())
  findings   Finding[]
}

model Finding {
  id            String      @id @default(cuid())
  explorationId String
  exploration   Exploration @relation(fields: [explorationId], references: [id], onDelete: Cascade)
  title         String
  description   String
  severity      Severity?
  reproSteps    Json?
  screenshot    String?
  defectId      String?
  defect        Defect?     @relation(fields: [defectId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
}

model Defect {
  id                String           @id @default(cuid())
  title             String
  severity          Severity
  moduleId          String?
  module            Module?          @relation(fields: [moduleId], references: [id])
  processId         String?
  process           BusinessProcess? @relation(fields: [processId], references: [id], onDelete: SetNull)
  repro             String
  evidence          Json?
  status            DefectStatus     @default(DRAFT)
  linkedTestCaseIds Json             @default("[]") // string[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  findings          Finding[]
}

model Review {
  id              String     @id @default(cuid())
  kind            ReviewKind
  input           String
  output          Json?
  impactedModules Json       @default("[]") // ModuleCode[]
  createdAt       DateTime   @default(now())
}

enum AuditStatus {
  OK
  ERROR
  BLOCKED
}

// Metadata only: prompt and response text are never stored here.
model AuditLog {
  id             String      @id @default(cuid())
  at             DateTime    @default(now())
  task           String
  provider       String // "local" | "anthropic"
  model          String
  status         AuditStatus @default(OK)
  tokensIn       Int         @default(0)
  tokensOut      Int         @default(0)
  costMicroUsd   Int         @default(0) // integer micro-dollars; 1_000_000 = $1
  durationMs     Int         @default(0)
  redacted       Boolean     @default(false)
  redactionCount Int         @default(0)
  sensitive      Boolean     @default(false)
  error          String?
  jobId          String?

  @@index([at])
  @@index([provider, at])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ── QA Hub: accounts and the who's-who directory (Phase 3.5a) ──

enum UserRole {
  ADMIN
  QA
  DEV
}

model User {
  id                 String       @id @default(cuid())
  name               String
  email              String       @unique // stored lower-case
  passwordHash       String
  role               UserRole
  active             Boolean      @default(true)
  /// Signed up on the sign-in page and waiting for an admin. Pending accounts are also inactive, so they can't sign in.
  pending            Boolean      @default(false)
  mustChangePassword Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  sessions           Session[]
  areas              AreaMember[]
  reported           Ticket[]        @relation("TicketReporter")
  assigned           Ticket[]        @relation("TicketAssignee")
  comments           TicketComment[]
  ticketEvents       TicketEvent[]
  attachments        Attachment[]
  pendingUploads     PendingUpload[]
  darProfile         DarProfile?
  darReports         DarReport[]
}

model Session {
  id        String   @id // SHA-256 of the cookie token; the raw token is never stored
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// The ERP's real module → sub-module tree used by tickets and the team directory.
/// Separate from `Module`, whose four fixed codes belong to the AI workbench.
model ErpArea {
  id         String       @id @default(cuid())
  parentId   String?
  parent     ErpArea?     @relation("AreaTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   ErpArea[]    @relation("AreaTree")
  name       String
  code       String?      @unique
  moduleCode ModuleCode?
  sortOrder  Int          @default(0)
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  members    AreaMember[]
  tickets    Ticket[]

  @@unique([parentId, name])
}

model AreaMember {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  areaId    String
  area      ErpArea  @relation(fields: [areaId], references: [id], onDelete: Cascade)
  isLead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@id([userId, areaId])
  @@index([areaId])
}

// ── QA Hub: tickets (Phase 3.5b) ──
// Ticket text and attachments show customer data, so they never go to an LLM (CLAUDE.md rule 12).

enum TicketType {
  BUG
  SUGGESTION
  IMPROVEMENT
}

enum TicketStatus {
  NEW
  IN_PROGRESS
  NEED_INFO
  FIXED
  VERIFIED
  CLOSED
  REOPENED
  REJECTED
  DUPLICATE
  WONT_FIX
}

enum AttachmentKind {
  IMAGE
  VIDEO
}

model Ticket {
  id             String          @id @default(cuid())
  number         Int             @unique // shown as #12; max + 1 when created
  type           TicketType
  title          String
  description    String
  status         TicketStatus    @default(NEW)
  severity       Severity? // bugs only
  priority       Priority        @default(P3)
  foundIn        String? // ERP build or environment, free text
  areaId         String?
  area           ErpArea?        @relation(fields: [areaId], references: [id], onDelete: SetNull)
  reporterId     String
  reporter       User            @relation("TicketReporter", fields: [reporterId], references: [id])
  assigneeId     String?
  assignee       User?           @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  duplicateOfId  String?
  duplicateOf    Ticket?         @relation("TicketDuplicate", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates     Ticket[]        @relation("TicketDuplicate")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  lastActivityAt DateTime        @default(now())
  closedAt       DateTime?
  comments       TicketComment[]
  events         TicketEvent[]
  attachments    Attachment[]

  @@index([status, lastActivityAt])
  @@index([assigneeId, status])
  @@index([areaId])
  @@index([reporterId])
}

model TicketComment {
  id          String       @id @default(cuid())
  ticketId    String
  ticket      Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId    String
  author      User         @relation(fields: [authorId], references: [id])
  body        String
  createdAt   DateTime     @default(now())
  attachments Attachment[]

  @@index([ticketId, createdAt])
}

/// The timeline. `kind` is CREATED | STATUS | ASSIGNEE | FIELD; `from`/`to` hold the old and new values.
model TicketEvent {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  kind      String
  field     String?
  from      String?
  to        String?
  note      String?
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

/// The file lives in UPLOAD_DIR under `storedName` (generated). `originalName` is for display only.
model Attachment {
  id           String         @id @default(cuid())
  ticketId     String
  ticket       Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  commentId    String?
  comment      TicketComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  uploaderId   String
  uploader     User           @relation(fields: [uploaderId], references: [id])
  kind         AttachmentKind
  storedName   String         @unique
  originalName String
  mime         String
  size         Int
  durationSec  Int? // videos, when the file says how long it is
  createdAt    DateTime       @default(now())

  @@index([ticketId])
}

/// A video streamed to UPLOAD_DIR before its ticket or reply is sent. The form claims it by id; unclaimed ones are
/// swept after a day.
model PendingUpload {
  id           String   @id @default(cuid())
  uploaderId   String
  uploader     User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  storedName   String   @unique
  originalName String
  mime         String
  size         Int
  durationSec  Int?
  createdAt    DateTime @default(now())

  @@index([uploaderId])
  @@index([createdAt])
}

// ── QA Hub: Daily Accomplishment Report (DAR) ──

/// A QA tester's own DAR details. Empty fields fall back to the admin's template (Setting "dar.template").
model DarProfile {
  userId           String   @id
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName         String? // the formal name on the report; accounts only hold a nickname
  position         String?
  coreFunctions    Json? // [{ duty, mfo, autofill }]
  supportFunctions Json?
  updatedAt        DateTime @updatedAt
}

/// One tester's DAR for one half-month period. Only what the tester typed is stored; the header comes from the
/// template and profile when the file is made.
model DarReport {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodStart   String // "2026-10-16", a date in Manila
  periodEnd     String
  cells         Json // { core: string[][], support: string[][] }, one string per day per function row
  dateSubmitted String? // "2026-10-31"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, periodStart])
}
